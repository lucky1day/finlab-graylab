def _validate_runtime() -> None:
    """Reject runtimes that cannot load the embedded native modules."""
    if (
        sys.implementation.name != "cpython"
        or sys.version_info[:2] != (3, 13)
    ):
        raise RuntimeError("requires CPython 3.13")
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise RuntimeError("requires macOS arm64")


def _payload_parts(relative_path: str) -> tuple[str, ...]:
    """Return canonical manifest components or reject the path."""
    path = PurePosixPath(relative_path)
    if (
        not relative_path
        or path.is_absolute()
        or relative_path != path.as_posix()
        or "\\" in relative_path
        or any(part in {"", ".", ".."} for part in path.parts)
    ):
        raise ValueError(f"unsafe payload path: {relative_path!r}")
    return path.parts


def _safe_payload_path(root: Path, relative_path: str) -> Path:
    """Resolve one manifest path without permitting extraction-root escape."""
    parts = _payload_parts(relative_path)
    root = Path(root)
    if root.is_symlink():
        raise ValueError(f"unsafe payload path: {relative_path!r}")
    resolved_root = root.resolve(strict=False)
    candidate = root.joinpath(*parts)
    current = root
    for part in parts:
        current = current / part
        if current.is_symlink():
            raise ValueError(f"unsafe payload path: {relative_path!r}")
    if not candidate.resolve(strict=False).is_relative_to(resolved_root):
        raise ValueError(f"unsafe payload path: {relative_path!r}")
    return candidate


def _decode_payload_entry(entry: dict[str, object]) -> tuple[str, bytes]:
    """Validate and decode one embedded manifest entry entirely in memory."""
    relative_path = entry.get("relative_path")
    chunks = entry.get("encoded_chunks")
    if not isinstance(relative_path, str) or not isinstance(chunks, list):
        raise ValueError("invalid payload manifest entry")
    if not all(isinstance(chunk, str) for chunk in chunks):
        raise ValueError(f"invalid payload chunks: {relative_path}")
    _payload_parts(relative_path)

    compressed = base64.b85decode("".join(chunks).encode("ascii"))
    compressed_hash = hashlib.sha256(compressed).hexdigest()
    if compressed_hash != entry.get("compressed_sha256"):
        raise ValueError(f"compressed payload hash mismatch: {relative_path}")
    raw = lzma.decompress(compressed)
    if (
        len(raw) != entry.get("raw_size")
        or hashlib.sha256(raw).hexdigest() != entry.get("raw_sha256")
    ):
        raise ValueError(f"raw payload hash mismatch: {relative_path}")
    return relative_path, raw


_DIRECTORY_OPEN_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def _open_extraction_root(root: Path) -> int:
    """Open a cwd-relative extraction root component-by-component without links."""
    requested = Path(root)
    if (
        requested.is_absolute()
        or not requested.parts
        or any(part in {"", ".", ".."} for part in requested.parts)
    ):
        raise ValueError("unsafe payload extraction root")
    descriptor = os.open(".", _DIRECTORY_OPEN_FLAGS)
    try:
        for part in requested.parts:
            created = False
            try:
                next_descriptor = os.open(
                    part, _DIRECTORY_OPEN_FLAGS, dir_fd=descriptor
                )
            except FileNotFoundError:
                os.mkdir(part, mode=0o700, dir_fd=descriptor)
                created = True
                next_descriptor = os.open(
                    part, _DIRECTORY_OPEN_FLAGS, dir_fd=descriptor
                )
            except OSError as error:
                raise ValueError("unsafe payload extraction root") from error
            os.close(descriptor)
            descriptor = next_descriptor
            if created:
                os.fchmod(descriptor, 0o700)
        os.fchmod(descriptor, 0o700)
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _open_existing_extraction_root(root: Path) -> int:
    """Open an existing cwd-relative payload root without following links."""
    requested = Path(root)
    if (
        requested.is_absolute()
        or not requested.parts
        or any(part in {"", ".", ".."} for part in requested.parts)
    ):
        raise ValueError("unsafe payload extraction root")
    descriptor = os.open(".", _DIRECTORY_OPEN_FLAGS)
    try:
        for part in requested.parts:
            try:
                next_descriptor = os.open(
                    part,
                    _DIRECTORY_OPEN_FLAGS,
                    dir_fd=descriptor,
                )
            except OSError as error:
                raise ValueError("unsafe payload extraction root") from error
            os.close(descriptor)
            descriptor = next_descriptor
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _open_payload_parent(
    root_descriptor: int,
    parts: tuple[str, ...],
    relative_path: str,
) -> int:
    """Retain a no-follow descriptor for one payload file's parent."""
    descriptor = os.dup(root_descriptor)
    try:
        for part in parts:
            try:
                os.mkdir(part, mode=0o700, dir_fd=descriptor)
            except FileExistsError:
                pass
            except OSError as error:
                raise ValueError(
                    f"unsafe payload path: {relative_path!r}"
                ) from error
            try:
                next_descriptor = os.open(
                    part, _DIRECTORY_OPEN_FLAGS, dir_fd=descriptor
                )
            except OSError as error:
                raise ValueError(
                    f"unsafe payload path: {relative_path!r}"
                ) from error
            os.fchmod(next_descriptor, 0o700)
            os.close(descriptor)
            descriptor = next_descriptor
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _verify_installed_file(
    parent_descriptor: int,
    filename: str,
    expected_size: int,
    expected_sha256: str,
) -> None:
    """Verify the installed inode without following a replacement link."""
    open_flags = (
        os.O_RDONLY
        | os.O_NOFOLLOW
        | os.O_NONBLOCK
        | getattr(os, "O_CLOEXEC", 0)
    )
    descriptor = os.open(
        filename,
        open_flags,
        dir_fd=parent_descriptor,
    )
    try:
        installed = os.fstat(descriptor)
        if not stat.S_ISREG(installed.st_mode):
            raise ValueError(f"payload post-install mismatch: {filename}")
        digest = hashlib.sha256()
        while chunk := os.read(descriptor, 1024 * 1024):
            digest.update(chunk)
        if (
            stat.S_IMODE(installed.st_mode) != 0o600
            or installed.st_size != expected_size
            or digest.hexdigest() != expected_sha256
        ):
            raise ValueError(f"payload post-install mismatch: {filename}")
    finally:
        os.close(descriptor)


def _remove_installed_entry(parent_descriptor: int, filename: str) -> None:
    """Remove an installed name by its no-follow entry type."""
    try:
        installed = os.stat(
            filename,
            dir_fd=parent_descriptor,
            follow_symlinks=False,
        )
    except FileNotFoundError:
        return
    if stat.S_ISDIR(installed.st_mode):
        os.rmdir(filename, dir_fd=parent_descriptor)
    else:
        os.unlink(filename, dir_fd=parent_descriptor)


def _extract_payload(run_root: Path) -> Path:
    """Integrity-check and atomically extract the private embedded payload."""
    _validate_runtime()

    decoded: list[tuple[str, bytes]] = []
    seen_paths: set[str] = set()
    for entry in _PAYLOAD_MANIFEST:
        relative_path, raw = _decode_payload_entry(entry)
        if relative_path in seen_paths:
            raise ValueError(f"duplicate payload path: {relative_path}")
        seen_paths.add(relative_path)
        decoded.append((relative_path, raw))

    payload_root = Path(run_root)
    root_descriptor = _open_extraction_root(payload_root)
    try:
        for relative_path, raw in decoded:
            parts = _payload_parts(relative_path)
            parent_descriptor = _open_payload_parent(
                root_descriptor, parts[:-1], relative_path
            )
            filename = parts[-1]
            temporary_name = f".{filename}.{secrets.token_hex(12)}.tmp"
            temporary_descriptor = -1
            installed = False
            try:
                temporary_descriptor = os.open(
                    temporary_name,
                    os.O_WRONLY
                    | os.O_CREAT
                    | os.O_EXCL
                    | os.O_NOFOLLOW,
                    0o600,
                    dir_fd=parent_descriptor,
                )
                os.fchmod(temporary_descriptor, 0o600)
                with os.fdopen(temporary_descriptor, "wb") as handle:
                    temporary_descriptor = -1
                    handle.write(raw)
                    handle.flush()
                    os.fsync(handle.fileno())
                try:
                    existing = os.stat(
                        filename,
                        dir_fd=parent_descriptor,
                        follow_symlinks=False,
                    )
                except FileNotFoundError:
                    existing = None
                if existing is not None and not stat.S_ISREG(existing.st_mode):
                    raise ValueError(f"unsafe payload path: {relative_path!r}")
                os.rename(
                    temporary_name,
                    filename,
                    src_dir_fd=parent_descriptor,
                    dst_dir_fd=parent_descriptor,
                )
                installed = True
                try:
                    _verify_installed_file(
                        parent_descriptor,
                        filename,
                        len(raw),
                        hashlib.sha256(raw).hexdigest(),
                    )
                except BaseException as error:
                    try:
                        _remove_installed_entry(parent_descriptor, filename)
                    except BaseException as cleanup_error:
                        error.add_note(
                            "post-install cleanup failed: "
                            f"{type(cleanup_error).__name__}: {cleanup_error}"
                        )
                    installed = False
                    if isinstance(error, ValueError):
                        raise
                    raise ValueError(
                        f"payload post-install mismatch: {relative_path}"
                    ) from error
            finally:
                if temporary_descriptor >= 0:
                    os.close(temporary_descriptor)
                if not installed:
                    try:
                        os.unlink(temporary_name, dir_fd=parent_descriptor)
                    except FileNotFoundError:
                        pass
                os.close(parent_descriptor)
    finally:
        os.close(root_descriptor)
    return payload_root


def _open_existing_payload_parent(
    root_descriptor: int,
    parts: tuple[str, ...],
    relative_path: str,
) -> int:
    descriptor = os.dup(root_descriptor)
    try:
        for part in parts:
            try:
                next_descriptor = os.open(
                    part,
                    _DIRECTORY_OPEN_FLAGS,
                    dir_fd=descriptor,
                )
            except OSError as error:
                raise ValueError(
                    f"payload load-time integrity mismatch: {relative_path}"
                ) from error
            os.close(descriptor)
            descriptor = next_descriptor
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _open_verified_manifest_file(
    root_descriptor: int,
    entry: dict[str, object],
) -> tuple[
    str,
    int,
    tuple[int, int, int, int, str],
    bytes | None,
]:
    open_flags = (
        os.O_RDONLY
        | os.O_NOFOLLOW
        | os.O_NONBLOCK
        | getattr(os, "O_CLOEXEC", 0)
    )
    relative_path = entry.get("relative_path")
    expected_size = entry.get("raw_size")
    expected_hash = entry.get("raw_sha256")
    if (
        not isinstance(relative_path, str)
        or isinstance(expected_size, bool)
        or not isinstance(expected_size, int)
        or not isinstance(expected_hash, str)
    ):
        raise ValueError("payload load-time integrity mismatch: manifest")
    parts = _payload_parts(relative_path)
    parent_descriptor = _open_existing_payload_parent(
        root_descriptor,
        parts[:-1],
        relative_path,
    )
    descriptor = -1
    try:
        try:
            descriptor = os.open(
                parts[-1],
                open_flags,
                dir_fd=parent_descriptor,
            )
        except OSError as error:
            raise ValueError(
                f"payload load-time integrity mismatch: {relative_path}"
            ) from error
        installed = os.fstat(descriptor)
        digest = hashlib.sha256()
        source_chunks: list[bytes] | None = (
            [] if relative_path.endswith(".py") else None
        )
        while chunk := os.read(descriptor, 1024 * 1024):
            digest.update(chunk)
            if source_chunks is not None:
                source_chunks.append(chunk)
        actual_hash = digest.hexdigest()
        if (
            not stat.S_ISREG(installed.st_mode)
            or stat.S_IMODE(installed.st_mode) != 0o600
            or installed.st_size != expected_size
            or actual_hash != expected_hash
        ):
            raise ValueError(
                f"payload load-time integrity mismatch: {relative_path}"
            )
        os.lseek(descriptor, 0, os.SEEK_SET)
        identity = (
            installed.st_dev,
            installed.st_ino,
            installed.st_mode,
            installed.st_size,
            actual_hash,
        )
        frozen_source = (
            b"".join(source_chunks)
            if source_chunks is not None
            else None
        )
        return relative_path, descriptor, identity, frozen_source
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    finally:
        os.close(parent_descriptor)


def _verified_payload_identities(
    root_descriptor: int,
) -> dict[str, tuple[int, int, int, int, str]]:
    """Verify every manifest file through no-follow descriptors."""
    identities: dict[str, tuple[int, int, int, int, str]] = {}
    for entry in _PAYLOAD_MANIFEST:
        (
            relative_path,
            descriptor,
            identity,
            _frozen_source,
        ) = _open_verified_manifest_file(root_descriptor, entry)
        try:
            identities[relative_path] = identity
        finally:
            if descriptor >= 0:
                os.close(descriptor)
    if len(identities) != len(_PAYLOAD_MANIFEST):
        raise ValueError("payload load-time integrity mismatch: manifest")
    return identities


def _open_verified_payload_files(
    root_descriptor: int,
) -> tuple[
    dict[str, int],
    dict[str, tuple[int, int, int, int, str]],
    dict[str, bytes],
]:
    descriptors: dict[str, int] = {}
    identities: dict[str, tuple[int, int, int, int, str]] = {}
    frozen_sources: dict[str, bytes] = {}
    try:
        for entry in _PAYLOAD_MANIFEST:
            (
                relative_path,
                descriptor,
                identity,
                frozen_source,
            ) = _open_verified_manifest_file(root_descriptor, entry)
            if relative_path in descriptors:
                os.close(descriptor)
                raise ValueError(
                    "payload load-time integrity mismatch: manifest"
                )
            descriptors[relative_path] = descriptor
            identities[relative_path] = identity
            if frozen_source is not None:
                frozen_sources[relative_path] = frozen_source
        if len(descriptors) != len(_PAYLOAD_MANIFEST):
            raise ValueError("payload load-time integrity mismatch: manifest")
        return descriptors, identities, frozen_sources
    except BaseException:
        for descriptor in descriptors.values():
            os.close(descriptor)
        raise


def _payload_module_name(
    relative_path: str,
) -> tuple[str, bool, str]:
    extension_suffix = ".cpython-313-darwin.so"
    if relative_path.endswith(extension_suffix):
        stem = relative_path[: -len(extension_suffix)]
        module_type = "extension"
        is_package = False
    elif relative_path.endswith(".py"):
        stem = relative_path[:-3]
        module_type = "python"
        package_suffix = "/" + "__init__"
        is_package = stem.endswith(package_suffix)
        if is_package:
            stem = stem[: -len(package_suffix)]
    else:
        raise ValueError(
            f"payload module path is unsupported: {relative_path}"
        )
    prefix = "daily_project/src/"
    if stem.startswith(prefix):
        stem = stem[len(prefix) :]
    elif "/" in stem:
        raise ValueError(
            f"payload module path is unsupported: {relative_path}"
        )
    return stem.replace("/", "."), is_package, module_type


def _read_retained_descriptor(descriptor: int) -> bytes:
    installed = os.fstat(descriptor)
    remaining = installed.st_size
    offset = 0
    chunks: list[bytes] = []
    while remaining:
        chunk = os.pread(
            descriptor,
            min(remaining, 1024 * 1024),
            offset,
        )
        if not chunk:
            raise ImportError("verified payload descriptor was truncated")
        chunks.append(chunk)
        offset += len(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def _remove_private_tree(root: Path) -> None:
    try:
        shutil.rmtree(root)
    except FileNotFoundError:
        pass


def _materialize_verified_extensions(
    descriptors: dict[str, int],
    source_identities: dict[str, tuple[int, int, int, int, str]],
) -> tuple[Path, dict[str, tuple[int, int, int, int, str]]]:
    absolute_root = Path(
        tempfile.mkdtemp(
            prefix=".embedded-extension-loader-",
            dir=".",
        )
    )
    absolute_root.chmod(0o700)
    load_root = absolute_root.relative_to(Path.cwd())
    identities: dict[str, tuple[int, int, int, int, str]] = {}
    try:
        for relative_path, source_descriptor in descriptors.items():
            if not relative_path.endswith(".cpython-313-darwin.so"):
                continue
            raw = _read_retained_descriptor(source_descriptor)
            expected = source_identities[relative_path]
            digest = hashlib.sha256(raw).hexdigest()
            if len(raw) != expected[3] or digest != expected[4]:
                raise ValueError(
                    f"payload load-time integrity mismatch: {relative_path}"
                )
            destination = load_root / relative_path
            destination.parent.mkdir(
                parents=True,
                mode=0o700,
                exist_ok=True,
            )
            for parent in (
                destination.parent,
                *destination.parent.parents,
            ):
                if parent == Path(".") or parent == Path.cwd():
                    break
                if parent == load_root or load_root in parent.parents:
                    parent.chmod(0o700)
            descriptor = os.open(
                destination,
                os.O_WRONLY
                | os.O_CREAT
                | os.O_EXCL
                | os.O_NOFOLLOW,
                0o600,
            )
            try:
                os.fchmod(descriptor, 0o600)
                remaining = memoryview(raw)
                while remaining:
                    written = os.write(descriptor, remaining)
                    if written <= 0:
                        raise OSError(
                            "extension materialization made no progress"
                        )
                    remaining = remaining[written:]
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        identities = _verified_extension_identities(load_root)
        return load_root, identities
    except BaseException:
        _remove_private_tree(load_root)
        raise


def _verified_extension_identities(
    load_root: Path,
) -> dict[str, tuple[int, int, int, int, str]]:
    root_descriptor = _open_existing_extraction_root(load_root)
    identities: dict[str, tuple[int, int, int, int, str]] = {}
    try:
        for entry in _PAYLOAD_MANIFEST:
            relative_path = entry.get("relative_path")
            if (
                not isinstance(relative_path, str)
                or not relative_path.endswith(".cpython-313-darwin.so")
            ):
                continue
            (
                path,
                descriptor,
                identity,
                _frozen_source,
            ) = _open_verified_manifest_file(root_descriptor, entry)
            try:
                identities[path] = identity
            finally:
                os.close(descriptor)
        return identities
    finally:
        os.close(root_descriptor)


class _VerifiedPythonLoader(importlib.abc.Loader):
    def __init__(
        self,
        fullname: str,
        frozen_source: bytes,
        relative_path: str,
        is_package: bool,
    ) -> None:
        self.fullname = fullname
        self.frozen_source = frozen_source
        self.relative_path = relative_path
        self.is_package = is_package

    def create_module(self, spec: object) -> None:
        del spec
        return None

    def exec_module(self, module: ModuleType) -> None:
        origin = f"<embedded-payload:{self.relative_path}>"
        compiler = codeop.Compile()
        code = compiler(self.frozen_source, origin, "exec")
        module.__file__ = origin
        module.__cached__ = None
        if self.is_package:
            module.__path__ = []
        module.__dict__.setdefault("__builtins__", builtins.__dict__)
        FunctionType(code, module.__dict__)()


class _VerifiedExtensionLoader(importlib.abc.Loader):
    def __init__(
        self,
        fullname: str,
        load_path: Path,
        relative_path: str,
    ) -> None:
        self.delegate = importlib.machinery.ExtensionFileLoader(
            fullname,
            str(load_path),
        )
        self.delegate_spec = importlib.util.spec_from_file_location(
            fullname,
            str(load_path),
            loader=self.delegate,
        )
        self.logical_origin = f"embedded-payload/{relative_path}"

    def create_module(self, spec: object) -> ModuleType:
        del spec
        return self.delegate.create_module(self.delegate_spec)

    def exec_module(self, module: ModuleType) -> None:
        module.__file__ = self.logical_origin
        self.delegate.exec_module(module)


class _VerifiedPayloadFinder(importlib.abc.MetaPathFinder):
    _NAMESPACES = frozenset(
        {
            "daily.selected_models",
            "daily.selected_models.10y04",
        }
    )

    def __init__(
        self,
        descriptors: dict[str, int],
        frozen_sources: dict[str, bytes],
        extension_root: Path,
    ) -> None:
        self.extension_root = Path(extension_root)
        self.frozen_sources = frozen_sources
        self.bindings: dict[
            str,
            tuple[str, int, bool, str],
        ] = {}
        for relative_path, descriptor in descriptors.items():
            fullname, is_package, module_type = _payload_module_name(
                relative_path
            )
            if (
                module_type == "python"
                and relative_path not in frozen_sources
            ):
                raise ValueError("payload Python source is not frozen")
            if fullname in self.bindings:
                raise ValueError(
                    "payload module mapping contains a duplicate"
                )
            self.bindings[fullname] = (
                relative_path,
                descriptor,
                is_package,
                module_type,
            )
            basename = fullname.rsplit(".", 1)[-1]
            if (
                module_type == "extension"
                and basename != "_run_impl"
                and basename not in self.bindings
            ):
                self.bindings[basename] = (
                    relative_path,
                    descriptor,
                    False,
                    module_type,
                )
            common_prefix = "daily.selected_models."
            if fullname.startswith(f"{common_prefix}common"):
                common_alias = fullname[len(common_prefix) :]
                self.bindings[common_alias] = (
                    relative_path,
                    descriptor,
                    is_package,
                    module_type,
                )

    def manages(self, fullname: str) -> bool:
        return (
            fullname in self._NAMESPACES
            or fullname in self.bindings
            or fullname == "daily"
            or fullname.startswith("daily.")
        )

    def find_spec(
        self,
        fullname: str,
        path: object = None,
        target: object = None,
    ) -> object:
        del path, target
        if fullname in self._NAMESPACES:
            spec = importlib.machinery.ModuleSpec(
                fullname,
                loader=None,
                is_package=True,
            )
            spec.origin = "embedded-payload-namespace"
            spec.submodule_search_locations = []
            return spec
        binding = self.bindings.get(fullname)
        if binding is None:
            return None
        relative_path, descriptor, is_package, module_type = binding
        if module_type == "python":
            loader = _VerifiedPythonLoader(
                fullname,
                self.frozen_sources[relative_path],
                relative_path,
                is_package,
            )
            return importlib.util.spec_from_loader(
                fullname,
                loader,
                origin=f"<embedded-payload:{relative_path}>",
                is_package=is_package,
            )
        loader = _VerifiedExtensionLoader(
            fullname,
            self.extension_root / relative_path,
            relative_path,
        )
        return importlib.util.spec_from_loader(
            fullname,
            loader,
            origin=loader.logical_origin,
        )


def _anchor_modules(payload_root: Path) -> tuple[ModuleType, ModuleType]:
    """Import both anchors only through retained verified file descriptors."""
    payload_root = Path(payload_root)
    root_descriptor = _open_existing_extraction_root(payload_root)
    retained_descriptors: dict[str, int] = {}
    extension_root: Path | None = None
    try:
        (
            retained_descriptors,
            retained_identities,
            frozen_sources,
        ) = _open_verified_payload_files(root_descriptor)
        path_identities = _verified_payload_identities(root_descriptor)
        if path_identities != retained_identities:
            raise ValueError("payload load-time identity changed")

        (
            extension_root,
            extension_identities,
        ) = _materialize_verified_extensions(
            retained_descriptors,
            retained_identities,
        )
        finder = _VerifiedPayloadFinder(
            retained_descriptors,
            frozen_sources,
            extension_root,
        )
        previous_sys_path = list(sys.path)
        previous_meta_path = list(sys.meta_path)
        previous_payload_modules = {
            name: module
            for name, module in tuple(sys.modules.items())
            if finder.manages(name)
        }
        for name in previous_payload_modules:
            sys.modules.pop(name, None)
        sys.meta_path.insert(0, finder)
        importlib.invalidate_caches()
        try:
            five = importlib.import_module("daily.selected_models.5y10.run")
            ten = importlib.import_module("daily.selected_models.10y04.run")
            after_identities = _verified_payload_identities(root_descriptor)
            if after_identities != retained_identities:
                raise ValueError("payload load-time identity changed")
            after_extension_identities = _verified_extension_identities(
                extension_root
            )
            if after_extension_identities != extension_identities:
                raise ValueError("payload extension load identity changed")
            return five, ten
        finally:
            created_payload_modules = {
                name
                for name in tuple(sys.modules)
                if finder.manages(name)
            }
            sys.path[:] = previous_sys_path
            sys.meta_path[:] = previous_meta_path
            for name in created_payload_modules:
                sys.modules.pop(name, None)
            sys.modules.update(previous_payload_modules)
            importlib.invalidate_caches()
    finally:
        if extension_root is not None:
            _remove_private_tree(extension_root)
        for descriptor in retained_descriptors.values():
            os.close(descriptor)
        os.close(root_descriptor)


def _platform_file(data_dir: Path, filename: str) -> Path:
    """Resolve one required regular platform file without following links."""
    root = Path(data_dir)
    if root.is_symlink() or not root.is_dir():
        raise ValueError("invalid platform data directory")
    path = root / filename
    if path.is_symlink():
        raise ValueError(f"invalid platform input file: {filename}")
    if not path.is_file():
        raise FileNotFoundError(f"missing platform input file: {filename}")
    if not path.resolve().is_relative_to(root.resolve()):
        raise ValueError(f"platform input escaped data directory: {filename}")
    return path


def _read_platform_csv(data_dir: Path, filename: str) -> pd.DataFrame:
    """Read one required regular input file through the runtime audit hook."""
    path = _platform_file(data_dir, filename)
    with open(path, "rb") as handle:
        return pd.read_csv(handle, low_memory=False)


def _normalized_dates(
    frame: pd.DataFrame,
    column: str,
    filename: str,
) -> pd.Series:
    """Parse normalized dates so the caller can apply its causal cutoff."""
    if column not in frame.columns:
        raise ValueError(f"{filename}: missing required column {column}")
    try:
        dates = pd.to_datetime(frame[column], errors="raise").dt.normalize()
    except Exception as error:
        raise ValueError(f"{filename}: invalid {column}") from error
    if dates.isna().any():
        raise ValueError(f"{filename}: invalid {column}")
    return dates


def _integer_ids(
    frame: pd.DataFrame,
    column: str,
    filename: str,
) -> pd.Series:
    """Parse integer period identifiers so causal filtering can happen first."""
    if column not in frame.columns:
        raise ValueError(f"{filename}: missing required column {column}")
    try:
        numeric = pd.to_numeric(frame[column], errors="raise")
        values = numeric.astype("int64")
    except Exception as error:
        raise ValueError(f"{filename}: invalid {column}") from error
    if (
        not np.isfinite(numeric.to_numpy(dtype="float64")).all()
        or not np.equal(numeric.to_numpy(), values.to_numpy()).all()
    ):
        raise ValueError(f"{filename}: invalid {column}")
    return values


def _validate_monotonic(
    values: pd.Series,
    column: str,
    filename: str,
    *,
    unique: bool = True,
) -> None:
    """Validate ordering only after the request's causal view is selected."""
    if (
        values.isna().any()
        or (unique and values.duplicated().any())
        or not values.is_monotonic_increasing
    ):
        raise ValueError(f"{filename}: {column} must be strictly monotonic")


def _write_private_csv(frame: pd.DataFrame, path: Path) -> None:
    """Write one request-private input artifact with a private file mode."""
    frame.to_csv(path, index=False)
    path.chmod(0o600)


def _materialize_cutoff_data(
    data_dir: Path,
    feature_date: pd.Timestamp,
    daily_cutoff_key: str,
    weekly_cutoff_key: str,
    monthly_cutoff_key: str,
    work_dir: Path,
) -> Path:
    """Create the exact four causal input files for one request cutoff."""
    cutoff = pd.Timestamp(feature_date).normalize()
    if pd.isna(cutoff):
        raise ValueError("invalid feature_date")
    daily_cutoff = pd.Timestamp(daily_cutoff_key).normalize()
    weekly_cutoff = int(weekly_cutoff_key)
    monthly_cutoff = int(monthly_cutoff_key)

    daily = _read_platform_csv(data_dir, "daily_output.csv")
    calendar = _read_platform_csv(data_dir, "api_wind_date.csv")
    weekly = _read_platform_csv(data_dir, "weekly_output.csv")
    monthly = _read_platform_csv(data_dir, "monthly_output.csv")

    daily_dates = _normalized_dates(daily, "date", "daily_output.csv")
    calendar_dates = _normalized_dates(
        calendar,
        "rdate",
        "api_wind_date.csv",
    )
    weekly_ids = _integer_ids(
        weekly,
        "week_id",
        "weekly_output.csv",
    )
    calendar_week_ids = _integer_ids(
        calendar,
        "week_id",
        "api_wind_date.csv",
    )
    monthly_ids = _integer_ids(
        monthly,
        "month_id",
        "monthly_output.csv",
    )

    missing_yields = [
        column for column in _DIRECT_YIELD_COLUMNS if column not in daily.columns
    ]
    if missing_yields:
        raise ValueError(
            "daily_output.csv: missing required columns "
            + ", ".join(missing_yields)
        )
    daily = daily.loc[daily_dates <= daily_cutoff].copy()
    daily_dates = daily_dates.loc[daily.index]
    calendar = calendar.loc[calendar_dates <= cutoff].copy()
    calendar_dates = calendar_dates.loc[calendar.index]
    calendar_week_ids = calendar_week_ids.loc[calendar.index]
    weekly = weekly.loc[weekly_ids <= weekly_cutoff].copy()
    weekly_ids = weekly_ids.loc[weekly.index]
    monthly = monthly.loc[monthly_ids <= monthly_cutoff].copy()
    monthly_ids = monthly_ids.loc[monthly.index]

    _validate_monotonic(daily_dates, "date", "daily_output.csv")
    _validate_monotonic(
        calendar_dates,
        "rdate",
        "api_wind_date.csv",
    )
    _validate_monotonic(
        calendar_week_ids,
        "week_id",
        "api_wind_date.csv",
        unique=False,
    )
    _validate_monotonic(weekly_ids, "week_id", "weekly_output.csv")
    _validate_monotonic(monthly_ids, "month_id", "monthly_output.csv")

    retained_yields = daily.loc[:, _DIRECT_YIELD_COLUMNS].apply(
        pd.to_numeric,
        errors="coerce",
    )
    if not np.isfinite(
        retained_yields.to_numpy(dtype="float64")
    ).all():
        raise ValueError("daily_output.csv: direct yields must be finite")
    if daily.empty or daily_dates.iloc[-1] != daily_cutoff:
        raise ValueError("daily_output.csv: exact cutoff coverage is required")
    if calendar.empty or calendar_dates.iloc[-1] != cutoff:
        raise ValueError("api_wind_date.csv: exact cutoff coverage is required")
    if (
        weekly.empty
        or weekly_ids.iloc[-1] != weekly_cutoff
        or int(calendar_week_ids.iloc[-1]) != weekly_cutoff
    ):
        raise ValueError("weekly_output.csv: exact cutoff coverage is required")
    if monthly.empty or monthly_ids.iloc[-1] != monthly_cutoff:
        raise ValueError("monthly_output.csv: exact cutoff coverage is required")

    daily["date"] = daily_dates.dt.strftime("%Y-%m-%d")
    calendar["rdate"] = calendar_dates.dt.strftime("%Y-%m-%d")
    calendar["week_id"] = calendar_week_ids.astype("int64")
    weekly["week_id"] = weekly_ids.astype("int64")
    monthly["month_id"] = monthly_ids.astype("int64")

    protected_root = Path(work_dir)
    data_root = protected_root / "data"
    data_root.mkdir(parents=True, mode=0o700, exist_ok=False)
    data_root.chmod(0o700)
    _write_private_csv(daily, data_root / "daily_output.csv")
    _write_private_csv(weekly, data_root / "weekly_output.csv")
    _write_private_csv(monthly, data_root / "monthly_output.csv")
    _write_private_csv(calendar, data_root / "api_wind_date.csv")
    return protected_root


@contextmanager
def _runtime_open_scope():
    """Expose the generated runner's audited open hook to anchor code."""
    original = builtins.open
    builtins.open = open
    try:
        yield
    finally:
        builtins.open = original


@contextmanager
def _temporary_overrides(
    entries: tuple[tuple[object, str, object], ...],
):
    """Temporarily set audited replay anchors and restore them on failure."""
    originals: list[tuple[object, str, object]] = []
    try:
        for module, name, value in entries:
            originals.append((module, name, getattr(module, name)))
            setattr(module, name, value)
        yield
    finally:
        for module, name, value in reversed(originals):
            setattr(module, name, value)


def _find_prediction_frame(output_dir: Path) -> pd.DataFrame:
    """Return the longest dated CSV containing an authoritative score."""
    candidates: list[tuple[int, pd.DataFrame]] = []
    for path in Path(output_dir).rglob("*.csv"):
        try:
            with open(path, "rb") as handle:
                frame = pd.read_csv(handle, low_memory=False)
        except Exception:
            continue
        date_column = next(
            (
                column
                for column in ("feature_date", "date", "predict_date")
                if column in frame.columns
            ),
            None,
        )
        score_columns = {
            "prob_up",
            "model_prob_up",
            "candidate_score",
            "active_score",
        }.intersection(frame.columns)
        if date_column and score_columns:
            candidates.append((len(frame), frame))
    if not candidates:
        raise RuntimeError(
            f"anchor replay produced no dated score frame in {output_dir}"
        )
    return max(candidates, key=lambda item: item[0])[1]


@contextmanager
def _virtual_anchor_csv_scope(output_dir: Path):
    """Keep large intermediate anchor CSVs in memory, not the run directory."""
    output_root = Path(output_dir).resolve()
    cached_csv: dict[Path, str] = {}
    original_to_csv = pd.DataFrame.to_csv
    original_read_csv = pd.read_csv

    def output_key(value: object) -> Path | None:
        candidate: object = value
        if not isinstance(candidate, (str, bytes, os.PathLike)):
            candidate = getattr(candidate, "name", None)
        if not isinstance(candidate, (str, bytes, os.PathLike)):
            return None
        try:
            resolved = Path(os.fsdecode(candidate)).resolve()
        except (OSError, TypeError, ValueError):
            return None
        if resolved == output_root or output_root in resolved.parents:
            return resolved
        return None

    def virtual_to_csv(
        frame: pd.DataFrame,
        path_or_buf: object = None,
        *args: object,
        **kwargs: object,
    ) -> object:
        key = output_key(path_or_buf)
        if key is None:
            return original_to_csv(frame, path_or_buf, *args, **kwargs)
        render_options = dict(kwargs)
        mode = str(render_options.pop("mode", "w"))
        rendered = original_to_csv(frame, None, *args, **render_options)
        if not isinstance(rendered, str):
            raise RuntimeError("anchor CSV virtualization failed")
        cached_csv[key] = (
            cached_csv.get(key, "") + rendered
            if "a" in mode
            else rendered
        )
        key.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
        key.write_bytes(b"")
        key.chmod(0o600)
        return None

    def virtual_read_csv(
        filepath_or_buffer: object,
        *args: object,
        **kwargs: object,
    ) -> pd.DataFrame:
        key = output_key(filepath_or_buffer)
        if key is None or key not in cached_csv:
            return original_read_csv(filepath_or_buffer, *args, **kwargs)
        read_options = dict(kwargs)
        read_options.pop("memory_map", None)
        return original_read_csv(
            io.StringIO(cached_csv[key]),
            *args,
            **read_options,
        )

    pd.DataFrame.to_csv = virtual_to_csv
    pd.read_csv = virtual_read_csv
    try:
        yield
    finally:
        pd.DataFrame.to_csv = original_to_csv
        pd.read_csv = original_read_csv


def _remove_anchor_output(output_dir: Path) -> None:
    _remove_private_tree(output_dir)


def _run_5y10(
    module: ModuleType,
    protected_root: Path,
    output_dir: Path,
) -> pd.DataFrame:
    """Run the embedded 5Y10 anchor with the audited replay contract."""
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, mode=0o700, exist_ok=False)
    overrides = (
        (module.fixed_lgbm, "TEST_START", _ANCHOR_REPLAY_START),
        (module.fixed_lgbm, "SCREEN_END", _ANCHOR_REPLAY_START),
        (module.combo_overlay, "FULL_START", _ANCHOR_REPLAY_START),
        (module.combo_overlay, "SIM_START", _ANCHOR_REPLAY_START),
    )
    try:
        with (
            _virtual_anchor_csv_scope(output_dir),
            _runtime_open_scope(),
            _temporary_overrides(overrides),
        ):
            with redirect_stdout(sys.stderr):
                module.run(
                    Path(protected_root) / "data",
                    output_dir,
                    n_jobs=1,
                )
            return _find_prediction_frame(output_dir)
    finally:
        _remove_anchor_output(output_dir)


def _run_10y04(
    module: ModuleType,
    protected_root: Path,
    output_dir: Path,
    feature_date: pd.Timestamp,
) -> pd.DataFrame:
    """Run the embedded 10Y04 anchor with the audited replay contract."""
    cutoff = pd.Timestamp(feature_date).normalize()
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, mode=0o700, exist_ok=False)
    overrides = (
        (module._impl, "TEST_START", _ANCHOR_REPLAY_START),
        (module._impl, "SCREEN_END", _ANCHOR_REPLAY_START),
    )
    arguments = argparse.Namespace(
        data=Path(protected_root) / "data/daily_output.csv",
        output_dir=output_dir,
        test_end=cutoff.strftime("%Y-%m-%d"),
        n_jobs=1,
    )
    try:
        with (
            _virtual_anchor_csv_scope(output_dir),
            _runtime_open_scope(),
            _temporary_overrides(overrides),
        ):
            with redirect_stdout(sys.stderr):
                module.run(arguments)
            return _find_prediction_frame(output_dir)
    finally:
        _remove_anchor_output(output_dir)


def _anchor_score(
    frame: pd.DataFrame,
    anchor: str,
    feature_date: pd.Timestamp,
) -> pd.Series:
    """Normalize one anchor's authoritative score history through cutoff."""
    if anchor not in {"5Y10", "10Y04"}:
        raise ValueError(f"unknown anchor: {anchor}")
    date_column = next(
        (
            column
            for column in ("feature_date", "date", "predict_date")
            if column in frame.columns
        ),
        None,
    )
    score_column = next(
        (
            column
            for column in (
                "prob_up",
                "model_prob_up",
                "candidate_score",
                "active_score",
            )
            if column in frame.columns
        ),
        None,
    )
    if date_column is None or score_column is None:
        raise ValueError(f"{anchor}: no authoritative dated score")
    try:
        dates = pd.to_datetime(
            frame[date_column],
            errors="raise",
        ).dt.normalize()
    except Exception as error:
        raise ValueError(f"{anchor}: invalid score dates") from error
    raw = pd.to_numeric(frame[score_column], errors="coerce")
    scores = 2.0 * raw - 1.0 if "prob" in score_column else raw
    cutoff = pd.Timestamp(feature_date).normalize()
    selected = pd.DataFrame(
        {"feature_date": dates, "score": scores}
    ).loc[
        lambda values: values["feature_date"].between(
            _ANCHOR_REPLAY_START,
            cutoff,
        )
    ]
    if (
        selected.empty
        or not np.isfinite(selected["score"].to_numpy(dtype="float64")).all()
    ):
        raise ValueError(f"{anchor}: score history must be finite")
    selected = (
        selected.sort_values("feature_date", kind="stable")
        .drop_duplicates("feature_date", keep="last")
        .set_index("feature_date")
    )
    if cutoff not in selected.index:
        raise ValueError(f"{anchor}: exact cutoff score is required")
    result = selected["score"].astype("float64")
    result.name = anchor
    result.index.name = "feature_date"
    return result


def causal_rolling_quantile_thresholds(
    scores: pd.Series | np.ndarray,
    *,
    window: int,
    active_rate: float,
) -> np.ndarray:
    """Calculate strict-prior absolute-score activation thresholds."""
    values = np.asarray(scores, dtype=float)
    history_window = int(window)
    rate = float(active_rate)
    if values.ndim != 1:
        raise ValueError("quantile scores must be one-dimensional")
    if history_window < 2:
        raise ValueError("quantile window must be at least 2")
    if not 0.0 < rate < 1.0:
        raise ValueError("quantile active rate must be between 0 and 1")
    return (
        pd.Series(np.abs(values))
        .shift(1)
        .rolling(history_window, min_periods=history_window)
        .quantile(1.0 - rate)
        .to_numpy(dtype=float)
    )


def causal_anchor_transform(
    values: pd.Series,
    *,
    transform: str,
    history_rule: str,
) -> pd.Series:
    """Apply the frozen causal anchor transform."""
    if history_rule != "strict_prior":
        raise ValueError("anchor transform history rule is invalid")
    numeric = pd.to_numeric(values, errors="coerce").astype(float)
    if transform == "level":
        return numeric - 0.5
    if transform.startswith("delta"):
        try:
            lag = int(transform.removeprefix("delta"))
        except ValueError as error:
            raise ValueError("anchor delta transform is invalid") from error
        if lag < 1:
            raise ValueError("anchor delta lag must be positive")
        return numeric - numeric.shift(lag)
    if transform.startswith("z"):
        try:
            window = int(transform.removeprefix("z"))
        except ValueError as error:
            raise ValueError("anchor z transform is invalid") from error
        if window < 2:
            raise ValueError("anchor z window must be at least 2")
        minimum_history = max(10, window // 3)
        prior = numeric.shift(1)
        prior_mean = prior.rolling(
            window,
            min_periods=minimum_history,
        ).mean()
        prior_std = prior.rolling(
            window,
            min_periods=minimum_history,
        ).std(ddof=0)
        return (numeric - prior_mean) / prior_std.replace(0.0, np.nan)
    raise ValueError("anchor source transform is invalid")


def causal_direction_edges(
    raw_actions: pd.Series | np.ndarray,
    labels: pd.Series | np.ndarray,
    *,
    window: int,
    prior_strength: float,
    minimum_history: int,
) -> np.ndarray:
    """Estimate rolling direction edge from labels known strictly earlier."""
    actions = np.asarray(raw_actions, dtype=float)
    targets = np.asarray(labels, dtype=float)
    history_window = int(window)
    required_history = int(minimum_history)
    prior = float(prior_strength)
    if (
        actions.ndim != 1
        or targets.ndim != 1
        or len(actions) != len(targets)
    ):
        raise ValueError("direction actions and labels must be equal vectors")
    if history_window < 2:
        raise ValueError("direction edge window must be at least 2")
    if required_history < 1 or required_history > history_window:
        raise ValueError("direction edge minimum history is invalid")
    if not np.isfinite(prior) or prior < 0.0:
        raise ValueError(
            "direction edge prior strength must be non-negative"
        )
    finite_label = np.isfinite(targets)
    if not set(np.unique(targets[finite_label])).issubset({-1, 0, 1}):
        raise ValueError("direction edge label is outside {-1,0,+1}")
    finite_action = np.isfinite(actions)
    if not set(np.unique(actions[finite_action])).issubset({-1, 0, 1}):
        raise ValueError("direction edge action is outside {-1,0,+1}")

    payoff = np.full(len(actions), np.nan, dtype=float)
    active = np.full(len(actions), np.nan, dtype=float)
    observed = finite_label & finite_action
    payoff[observed] = 0.0
    active[observed] = 0.0
    traded = observed & (actions != 0.0)
    payoff[traded] = np.where(
        actions[traded] == targets[traded],
        1.0,
        -1.0,
    )
    active[traded] = 1.0
    payoff_sum = (
        pd.Series(payoff)
        .shift(1)
        .rolling(
            history_window,
            min_periods=required_history,
        )
        .sum()
        .to_numpy(dtype=float)
    )
    active_count = (
        pd.Series(active)
        .shift(1)
        .rolling(
            history_window,
            min_periods=required_history,
        )
        .sum()
        .to_numpy(dtype=float)
    )
    denominator = active_count + prior
    return np.divide(
        payoff_sum,
        denominator,
        out=np.full(len(actions), np.nan, dtype=float),
        where=np.isfinite(denominator) & (denominator > 0.0),
    )


def strict_prior_z(
    values: pd.Series | np.ndarray,
    *,
    window: int,
    minimum_history: int,
) -> pd.Series:
    """Standardize a vector against only its strictly prior history."""
    series = pd.Series(values, dtype=float).reset_index(drop=True)
    prior = series.shift(1)
    mean = prior.rolling(window, min_periods=minimum_history).mean()
    scale = prior.rolling(
        window,
        min_periods=minimum_history,
    ).std(ddof=0)
    return (series - mean) / scale.replace(0.0, np.nan)


def fair_value_error_matrix(
    daily: pd.DataFrame,
    *,
    direct_yield_columns: tuple[str, str, str],
    fair_value_weights: tuple[float, float],
    feature_mode: str,
    z_window: int,
) -> tuple[pd.DataFrame, np.ndarray]:
    """Build the frozen causal 7Y fair-value error features."""
    if feature_mode not in {
        "error_correction",
        "error_correction_momentum",
    }:
        raise ValueError(
            f"unknown fair-value feature mode: {feature_mode}"
        )
    window = int(z_window)
    if window < 20:
        raise ValueError("fair-value z window must be at least 20")
    front, target, back = direct_yield_columns
    columns = ("date", front, target, back)
    missing = set(columns).difference(daily.columns)
    if missing:
        raise ValueError(f"missing fair-value columns: {sorted(missing)}")
    enriched = daily.loc[:, columns].copy()
    enriched["date"] = pd.to_datetime(
        enriched["date"],
        errors="raise",
    ).dt.normalize()
    enriched = enriched.sort_values("date").reset_index(drop=True)
    if enriched["date"].duplicated().any():
        raise ValueError("fair-value dates must be unique")
    for column in columns[1:]:
        enriched[column] = pd.to_numeric(
            enriched[column],
            errors="coerce",
        )
    front_weight, back_weight = fair_value_weights
    enriched["fair_value"] = (
        front_weight * enriched[front]
        + back_weight * enriched[back]
    )
    enriched["fair_value_gap"] = (
        enriched[target] - enriched["fair_value"]
    )

    target_delta = enriched[target].diff()
    front_delta = enriched[front].diff()
    back_delta = enriched[back].diff()
    fair_delta = enriched["fair_value"].diff()
    gap_delta = enriched["fair_value_gap"].diff()

    def prior_scale(values: pd.Series) -> pd.Series:
        return (
            values.shift(1)
            .rolling(window, min_periods=window)
            .std(ddof=0)
            .replace(0.0, np.nan)
        )

    target_scale = prior_scale(target_delta)
    fair_scale = prior_scale(fair_delta)
    gap_scale = prior_scale(gap_delta)
    gap_mean = (
        enriched["fair_value_gap"]
        .shift(1)
        .rolling(window, min_periods=window)
        .mean()
    )
    gap_level_scale = (
        enriched["fair_value_gap"]
        .shift(1)
        .rolling(window, min_periods=window)
        .std(ddof=0)
        .replace(0.0, np.nan)
    )
    target_normalized = target_delta / target_scale
    fair_normalized = fair_delta / fair_scale
    gap_z = (
        enriched["fair_value_gap"] - gap_mean
    ) / gap_level_scale
    parts: list[np.ndarray] = [
        target_normalized.to_numpy(dtype=float),
        (front_delta / prior_scale(front_delta)).to_numpy(dtype=float),
        (back_delta / prior_scale(back_delta)).to_numpy(dtype=float),
        fair_normalized.to_numpy(dtype=float),
        gap_z.to_numpy(dtype=float),
        (gap_delta / gap_scale).to_numpy(dtype=float),
        (-gap_z).to_numpy(dtype=float),
        (target_normalized - fair_normalized).to_numpy(dtype=float),
    ]
    if feature_mode == "error_correction_momentum":
        for lookback in (3, 5, 10, 20):
            parts.append(
                (
                    enriched[target].diff(lookback) / target_scale
                ).to_numpy(dtype=float)
            )
        for lookback in (3, 10):
            parts.append(
                (
                    enriched["fair_value"].diff(lookback) / fair_scale
                ).to_numpy(dtype=float)
            )
        parts.extend(
            [
                (gap_z * np.sign(fair_delta)).to_numpy(dtype=float),
                (target_normalized * gap_z).to_numpy(dtype=float),
            ]
        )
    return enriched, np.column_stack(parts)


def _historical_fair_value_state_mask(
    matrix: np.ndarray,
    *,
    state_rule: str,
) -> np.ndarray:
    """Select the frozen fair-value state without reading target labels."""
    gap_z = matrix[:, 4]
    target_move = matrix[:, 0]
    fair_move = matrix[:, 3]
    if state_rule == "gap_positive":
        return gap_z >= 0.0
    if state_rule == "fair_up":
        return fair_move >= 0.0
    if state_rule == "target_up":
        return target_move >= 0.0
    if state_rule == "gap_fair_same":
        return gap_z * fair_move >= 0.0
    if state_rule == "gap_target_same":
        return gap_z * target_move >= 0.0
    if state_rule.startswith("gap_extreme_"):
        cutoff = {
            "gap_extreme_0_5": 0.5,
            "gap_extreme_1_0": 1.0,
            "gap_extreme_1_5": 1.5,
        }.get(state_rule)
        if cutoff is None:
            raise ValueError(
                "historical fair-value state rule is invalid"
            )
        return np.abs(gap_z) >= cutoff
    if state_rule.startswith("momentum"):
        momentum_column = {
            "momentum3_up": 8,
            "momentum5_up": 9,
            "momentum10_up": 10,
            "momentum20_up": 11,
        }.get(state_rule)
        if momentum_column is None or matrix.shape[1] <= momentum_column:
            raise ValueError(
                "historical fair-value momentum state is invalid"
            )
        return matrix[:, momentum_column] >= 0.0
    if state_rule == "gap_x_fair_positive":
        if matrix.shape[1] <= 14:
            raise ValueError(
                "historical fair-value interaction state is invalid"
            )
        return matrix[:, 14] >= 0.0
    raise ValueError("historical fair-value state rule is invalid")


def _normalized_score_history(
    values: pd.Series,
    *,
    dates: pd.Series,
    label: str,
) -> pd.Series:
    """Align one unique finite dated score history to the daily dates."""
    if not isinstance(values, pd.Series):
        raise TypeError(f"{label}: score history must be a Series")
    score_dates = pd.to_datetime(
        values.index,
        errors="raise",
    ).normalize()
    if score_dates.duplicated().any():
        raise ValueError(f"{label}: score dates must be unique")
    numeric = pd.to_numeric(values, errors="coerce").to_numpy(dtype=float)
    if not np.isfinite(numeric).all():
        raise ValueError(f"{label}: score history must be finite")
    history = pd.Series(numeric, index=score_dates)
    if not history.index.is_monotonic_increasing:
        history = history.sort_index()
    return history.reindex(pd.DatetimeIndex(dates)).reset_index(drop=True)


def _curve_orientation_actions(
    daily: pd.DataFrame,
    scheme: dict[str, object],
) -> pd.Series:
    """Return the scheme-specific frozen causal curve member actions."""
    if scheme != FROZEN_SCHEME:
        raise ValueError("curve scheme literal mismatch")
    direct_columns = _DIRECT_YIELD_COLUMNS
    missing = {"date", *direct_columns}.difference(daily.columns)
    if missing:
        raise ValueError(
            f"curve-orientation source is missing {sorted(missing)}"
        )
    dates = pd.to_datetime(
        daily["date"],
        errors="raise",
    ).dt.normalize()
    if dates.duplicated().any() or not dates.is_monotonic_increasing:
        raise ValueError(
            "curve-orientation dates must be unique and increasing"
        )
    front = pd.to_numeric(
        daily[direct_columns[0]],
        errors="coerce",
    ).astype(float)
    target = pd.to_numeric(
        daily[direct_columns[1]],
        errors="coerce",
    ).astype(float)
    back = pd.to_numeric(
        daily[direct_columns[2]],
        errors="coerce",
    ).astype(float)

    fair = 0.6 * front + 0.4 * back
    gap = target - fair
    gap_z = strict_prior_z(
        gap,
        window=84,
        minimum_history=42,
    ).to_numpy(dtype=float)
    spread = back - front
    raw_scores = (spread - spread.shift(42)).to_numpy(dtype=float)
    state_mask = np.abs(gap_z) >= 0.5
    raw_scores *= np.where(state_mask, 1.0, -1.0)
    labels = np.sign(
        target.shift(-1).to_numpy(dtype=float)
        - target.to_numpy(dtype=float)
    )
    raw_actions = np.sign(raw_scores)
    raw_actions[~np.isfinite(raw_actions)] = 0.0
    edges = causal_direction_edges(
        raw_actions,
        labels,
        window=42,
        prior_strength=0.0,
        minimum_history=int(scheme["edge_minimum_history"]),
    )
    scores = raw_scores * np.sign(edges)
    thresholds = causal_rolling_quantile_thresholds(
        scores,
        window=252,
        active_rate=0.55,
    )
    actions = np.zeros(len(scores), dtype="int64")
    actions[scores > thresholds] = 1
    actions[scores < -thresholds] = -1
    result = pd.Series(
        actions,
        index=pd.DatetimeIndex(dates),
        name="curve_action",
        dtype="int64",
    )
    result.index.name = "feature_date"
    return result


def _historical_anchor_actions(
    daily: pd.DataFrame,
    five: pd.Series,
    ten: pd.Series,
) -> pd.Series:
    """Return the shared frozen historical anchor-state member actions."""
    dates = pd.to_datetime(
        daily["date"],
        errors="raise",
    ).dt.normalize()
    if dates.duplicated().any() or not dates.is_monotonic_increasing:
        raise ValueError(
            "historical anchor dates must be unique and increasing"
        )
    five_score = _normalized_score_history(
        five,
        dates=dates,
        label="5Y10",
    )
    ten_score = _normalized_score_history(
        ten,
        dates=dates,
        label="10Y04",
    )
    anchor_score = causal_anchor_transform(
        1.0 * five_score - 1.0 * ten_score,
        transform="delta5",
        history_rule="strict_prior",
    ).to_numpy(dtype=float)
    enriched, matrix = fair_value_error_matrix(
        daily,
        direct_yield_columns=_DIRECT_YIELD_COLUMNS,
        fair_value_weights=(0.6, 0.4),
        feature_mode="error_correction_momentum",
        z_window=84,
    )
    state_mask = _historical_fair_value_state_mask(
        matrix,
        state_rule="gap_target_same",
    )
    scores = anchor_score * np.where(state_mask, 1, -1)
    thresholds = causal_rolling_quantile_thresholds(
        scores,
        window=42,
        active_rate=0.60,
    )
    actions = np.zeros(len(scores), dtype="int64")
    actions[scores > thresholds] = 1
    actions[scores < -thresholds] = -1
    result = pd.Series(
        actions,
        index=pd.DatetimeIndex(enriched["date"]),
        name="anchor_action",
        dtype="int64",
    )
    result.index.name = "feature_date"
    return result


def _weighted_vote(curve: pd.Series, anchor: pd.Series) -> pd.Series:
    """Apply the frozen 1:2 action vote; a zero total abstains."""
    if not isinstance(curve, pd.Series) or not isinstance(anchor, pd.Series):
        raise TypeError("consensus members must be Series")
    if not curve.index.equals(anchor.index):
        raise ValueError("consensus member dates must align exactly")
    curve_values = pd.to_numeric(curve, errors="coerce").to_numpy(dtype=float)
    anchor_values = pd.to_numeric(
        anchor,
        errors="coerce",
    ).to_numpy(dtype=float)
    if (
        not np.isfinite(curve_values).all()
        or not np.isfinite(anchor_values).all()
        or not set(np.unique(curve_values)).issubset({-1, 0, 1})
        or not set(np.unique(anchor_values)).issubset({-1, 0, 1})
    ):
        raise ValueError("consensus member actions must be finite ternary")
    actions = np.sign(
        1 * curve_values + 2 * anchor_values
    ).astype("int64")
    result = pd.Series(actions, index=curve.index, dtype="int64")
    if curve.name == anchor.name:
        result.name = curve.name
    return result


def _infer_one(
    data_dir: Path,
    feature_date: pd.Timestamp,
    daily_cutoff_key: str,
    weekly_cutoff_key: str,
    monthly_cutoff_key: str,
) -> dict[str, object]:
    """Run both embedded anchors and return one frozen consensus decision."""
    cutoff = pd.Timestamp(feature_date).normalize()
    if pd.isna(cutoff):
        raise ValueError("feature date is invalid")
    with tempfile.TemporaryDirectory(prefix="embedded-7y-", dir=".") as temporary:
        run_root = Path(temporary).relative_to(Path.cwd())
        payload_root = _extract_payload(run_root / "payload")
        five_module, ten_module = _anchor_modules(payload_root)
        protected_root = _materialize_cutoff_data(
            Path(data_dir),
            cutoff,
            daily_cutoff_key,
            weekly_cutoff_key,
            monthly_cutoff_key,
            run_root / "request",
        )
        five_frame = _run_5y10(
            five_module,
            protected_root,
            run_root / "five",
        )
        ten_frame = _run_10y04(
            ten_module,
            protected_root,
            run_root / "ten",
            cutoff,
        )
        five_score = _anchor_score(five_frame, "5Y10", cutoff)
        ten_score = _anchor_score(ten_frame, "10Y04", cutoff)
        daily = _read_platform_csv(
            protected_root / "data",
            "daily_output.csv",
        )
        curve = _curve_orientation_actions(daily, FROZEN_SCHEME)
        anchor = _historical_anchor_actions(daily, five_score, ten_score)
        action = _weighted_vote(curve, anchor)
        if cutoff not in action.index:
            raise ValueError("exact cutoff consensus action is required")
        curve_action = int(curve.loc[cutoff])
        anchor_action = int(anchor.loc[cutoff])
        vote = 1 * curve_action + 2 * anchor_action
        return {
            "scheme_id": str(FROZEN_SCHEME["scheme_id"]),
            "feature_date": cutoff.strftime("%Y-%m-%d"),
            "curve_action": curve_action,
            "anchor_action": anchor_action,
            "vote": vote,
            "action": int(action.loc[cutoff]),
        }


def _strict_date(value: object, field: str) -> date:
    """Parse one canonical Request date without normalizing caller input."""
    if not isinstance(value, str) or _DATE_PATTERN.fullmatch(value) is None:
        raise ValueError(f"{field} must use YYYY-MM-DD")
    try:
        parsed = datetime.strptime(value, "%Y-%m-%d").date()
    except ValueError as error:
        raise ValueError(f"{field} must use YYYY-MM-DD") from error
    if parsed.isoformat() != value:
        raise ValueError(f"{field} must use YYYY-MM-DD")
    return parsed


def _strict_period(value: object, field: str) -> str:
    """Validate one six-digit cutoff key without replacing it."""
    if not isinstance(value, str) or _PERIOD_PATTERN.fullmatch(value) is None:
        raise ValueError(f"{field} must contain six digits")
    return value


def _validate_request(
    request: dict[str, object],
) -> tuple[dict[str, object], date]:
    """Validate one exact seven-field Request and preserve its values."""
    if not isinstance(request, dict):
        raise TypeError("each Request must be an object")
    if set(request) != set(_REQUEST_FIELDS):
        raise ValueError("Request fields must match Contract 1.0 exactly")
    if not all(isinstance(request[field], str) for field in _REQUEST_FIELDS):
        raise TypeError("all Request fields must be strings")
    request_id = request["request_id"]
    if not isinstance(request_id, str) or not request_id.strip():
        raise ValueError("request_id must be a nonempty string")

    predict_date = _strict_date(request["predict_date"], "predict_date")
    feature_date = _strict_date(request["feature_date"], "feature_date")
    target_date = _strict_date(request["target_date"], "target_date")
    daily_cutoff = _strict_date(
        request["daily_cutoff_key"],
        "daily_cutoff_key",
    )
    _strict_period(
        request["weekly_cutoff_key"],
        "weekly_cutoff_key",
    )
    monthly_cutoff = _strict_period(
        request["monthly_cutoff_key"],
        "monthly_cutoff_key",
    )
    if not feature_date <= predict_date <= target_date:
        raise ValueError(
            "dates must satisfy feature_date <= predict_date <= target_date"
        )
    if feature_date >= target_date:
        raise ValueError("feature_date must be earlier than target_date")
    if daily_cutoff != feature_date:
        raise ValueError("daily_cutoff_key must equal feature_date")
    if monthly_cutoff != feature_date.strftime("%Y%m"):
        raise ValueError(
            "monthly_cutoff_key is inconsistent with feature_date"
        )
    return request, feature_date


def _validate_weekly_cutoffs(
    validated: list[tuple[dict[str, object], date]],
    data_dir: Path,
) -> None:
    """Validate supplied weekly keys against api-wind-date-v1 only."""
    calendar = _read_platform_csv(data_dir, "api_wind_date.csv")
    if list(calendar.columns) != ["rdate", "week_id"]:
        raise ValueError(
            "api_wind_date.csv must contain exactly rdate,week_id"
        )
    dates = _normalized_dates(calendar, "rdate", "api_wind_date.csv")
    latest_feature = max(feature_date for _, feature_date in validated)
    causal = dates <= pd.Timestamp(latest_feature)
    calendar = calendar.loc[causal].copy()
    dates = dates.loc[calendar.index]
    raw_dates = calendar["rdate"].astype("string")
    canonical_dates = dates.dt.strftime("%Y-%m-%d")
    if not raw_dates.eq(canonical_dates).all():
        raise ValueError("api_wind_date.csv: rdate must use YYYY-MM-DD")
    week_ids = _integer_ids(
        calendar,
        "week_id",
        "api_wind_date.csv",
    )
    canonical_weeks = week_ids.astype(str)
    if not canonical_weeks.str.fullmatch(_PERIOD_PATTERN).all():
        raise ValueError("api_wind_date.csv: week_id must contain six digits")
    _validate_monotonic(dates, "rdate", "api_wind_date.csv")
    mapping = dict(zip(canonical_dates, canonical_weeks, strict=True))
    for request, feature_date in validated:
        feature_key = feature_date.isoformat()
        supplied = request["weekly_cutoff_key"]
        if mapping.get(feature_key) != supplied:
            raise ValueError(
                "weekly_cutoff_key is inconsistent with feature_date"
            )


def _input_file_hashes(data_dir: Path) -> tuple[str, ...]:
    """Hash the exact four immutable inputs used by one process."""
    digests: list[str] = []
    for filename in _PLATFORM_FILES:
        digest = hashlib.sha256()
        with open(_platform_file(data_dir, filename), "rb") as handle:
            while chunk := handle.read(1024 * 1024):
                digest.update(chunk)
        digests.append(digest.hexdigest())
    return tuple(digests)


def _execute_one(
    request: dict[str, object],
    data_dir: Path,
    *,
    feature_date: date,
    input_file_hashes: tuple[str, ...],
    cache: dict[tuple[object, ...], int],
) -> dict[str, object]:
    """Execute one validated Request and expose only its standard Result."""
    cache_key = (
        request["feature_date"],
        request["daily_cutoff_key"],
        request["weekly_cutoff_key"],
        request["monthly_cutoff_key"],
        input_file_hashes,
    )
    if cache_key not in cache:
        internal = _infer_one(
            Path(data_dir),
            pd.Timestamp(feature_date),
            request["daily_cutoff_key"],
            request["weekly_cutoff_key"],
            request["monthly_cutoff_key"],
        )
        action = internal.get("action")
        if (
            isinstance(action, bool)
            or not isinstance(action, (int, np.integer))
            or int(action) not in {-1, 0, 1}
        ):
            raise ValueError("algorithm produced an invalid direction")
        cache[cache_key] = int(action)
    return {
        "request_id": request["request_id"],
        "predict_date": request["predict_date"],
        "feature_date": request["feature_date"],
        "target_date": request["target_date"],
        "predicted_direction": cache[cache_key],
    }


def _execute_requests(
    requests: list[dict[str, object]],
    data_dir: Path,
) -> list[dict[str, object]]:
    """Validate and execute one to 100 independent Requests in order."""
    if not isinstance(requests, list):
        raise TypeError("Requests must be a list")
    if not 1 <= len(requests) <= 100:
        raise ValueError("a batch must contain one to 100 Requests")
    validated = [_validate_request(request) for request in requests]
    request_ids = [request["request_id"] for request, _ in validated]
    if len(request_ids) != len(set(request_ids)):
        raise ValueError("request_id values must be unique within a batch")
    _validate_weekly_cutoffs(validated, Path(data_dir))
    input_hashes = _input_file_hashes(Path(data_dir))
    cache: dict[tuple[object, ...], int] = {}
    return [
        _execute_one(
            request,
            Path(data_dir),
            feature_date=feature_date,
            input_file_hashes=input_hashes,
            cache=cache,
        )
        for request, feature_date in validated
    ]


@contextmanager
def _business_stdout_to_stderr():
    """Redirect Python and native fd-level business stdout to stderr."""
    sys.stdout.flush()
    sys.stderr.flush()
    saved_stdout = os.dup(1)
    try:
        os.dup2(2, 1)
        with redirect_stdout(sys.stderr):
            yield
    finally:
        sys.stdout.flush()
        sys.stderr.flush()
        os.dup2(saved_stdout, 1)
        os.close(saved_stdout)


def _strict_json_object(
    pairs: list[tuple[str, object]],
) -> dict[str, object]:
    """Build one JSON object while rejecting every duplicate member name."""
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON member: {key}")
        result[key] = value
    return result


def _read_predict_request(path: Path) -> list[dict[str, object]]:
    """Read one JSON Request without accepting a non-object payload."""
    with open(path, "r", encoding="utf-8") as handle:
        payload = json.load(
            handle,
            object_pairs_hook=_strict_json_object,
        )
    if not isinstance(payload, dict):
        raise TypeError("predict Request must be one JSON object")
    return [payload]


def _read_backtest_requests(path: Path) -> list[dict[str, object]]:
    """Read one strict seven-column Request CSV."""
    with open(path, "r", encoding="utf-8", newline="") as handle:
        reader = csv.DictReader(handle)
        if tuple(reader.fieldnames or ()) != _REQUEST_FIELDS:
            raise ValueError(
                "backtest Request columns must match Contract 1.0 exactly"
            )
        requests = [dict(row) for row in reader]
    return requests


def _json_result(results: list[dict[str, object]]) -> bytes:
    """Serialize the single predict Result as compact UTF-8 JSON."""
    if len(results) != 1:
        raise ValueError("predict must produce exactly one Result")
    return json.dumps(
        results[0],
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")


def _csv_results(results: list[dict[str, object]]) -> bytes:
    """Serialize ordered backtest Results with the exact five columns."""
    buffer = io.StringIO(newline="")
    writer = csv.DictWriter(
        buffer,
        fieldnames=_RESULT_FIELDS,
        extrasaction="raise",
        lineterminator="\n",
    )
    writer.writeheader()
    writer.writerows(results)
    return buffer.getvalue().encode("utf-8")


def _validate_output_destination(output: Path) -> None:
    """Require the SOP's absent output path without modifying existing data."""
    output = Path(output)
    if output.exists() or output.is_symlink():
        raise FileExistsError("output path must not already exist")
    parent = output.parent
    if parent.is_symlink() or not parent.is_dir():
        raise ValueError("output parent must be an existing directory")


def _atomic_write(output: Path, payload: bytes) -> None:
    """Durably write a same-directory temporary file, then replace output."""
    output = Path(output)
    _validate_output_destination(output)
    parent = output.parent
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{output.name}.",
        suffix=".tmp",
        dir=parent,
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, output)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _argument_parser() -> argparse.ArgumentParser:
    """Build the exact Contract 1.0 command-line interface."""
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    predict = commands.add_parser("predict")
    predict.add_argument("--request", required=True)
    predict.add_argument("--data-dir", required=True)
    predict.add_argument("--output", required=True)
    backtest = commands.add_parser("backtest")
    backtest.add_argument("--requests", required=True)
    backtest.add_argument("--data-dir", required=True)
    backtest.add_argument("--output", required=True)
    return parser


def main(arguments: list[str] | None = None) -> int:
    """Run one atomic predict or backtest command."""
    parsed = _argument_parser().parse_args(arguments)
    try:
        with _business_stdout_to_stderr():
            output = Path(parsed.output)
            _validate_output_destination(output)
            if parsed.command == "predict":
                requests = _read_predict_request(Path(parsed.request))
                serializer = _json_result
            else:
                requests = _read_backtest_requests(Path(parsed.requests))
                serializer = _csv_results
            results = _execute_requests(requests, Path(parsed.data_dir))
            payload = serializer(results)
            _atomic_write(output, payload)
        return 0
    except Exception as error:
        print(
            f"error: {type(error).__name__}: {error}",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
