"""Standalone embedded runtime for one deterministic 7Y delivery."""

from __future__ import annotations

import argparse
import base64
import builtins
from contextlib import contextmanager, redirect_stdout
import hashlib
import importlib
import lzma
import os
from pathlib import Path, PurePosixPath
import platform
import secrets
import stat
import sys
