<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bond Factor Lab — SSH 反向隧道（本地 Mac 常驻）
  ===========================================================================
  作用：把本地后端 127.0.0.1:8100 反向暴露到公网入口机的 127.0.0.1:18100，
        供入口机 Nginx proxy_pass 使用。绑定到远端 127.0.0.1，确保公网
        无法直连裸后端，只有入口机本地 Nginx 能访问。

  本文件只定义期望配置。占位符替换、安装、加载和状态核验必须按
  deploy/README.md 的独立授权边界执行，不能从模板存在推断现场变更权限。

  存活策略：
    - KeepAlive=true        ssh 进程退出后由 launchd 拉起（应对网络抖动/休眠）。
    - ServerAliveInterval   30s 无响应探测一次，连续 3 次失败即断开退出，
      ServerAliveCountMax   交给 launchd 重连，避免“僵尸隧道”占着端口不转发。
    - ExitOnForwardFailure  远端端口转发建立失败立即退出重试，不静默挂起。
    - ThrottleInterval=10   防止异常时每秒疯狂重启。
  ===========================================================================
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bond-factor-lab.ssh-tunnel</string>

  <key>WorkingDirectory</key>
  <string>/Users/macstudio0</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-T</string>
    <string>-o</string>
    <string>ServerAliveInterval=30</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>-o</string>
    <string>ExitOnForwardFailure=yes</string>
    <string>-o</string>
    <string>StrictHostKeyChecking=accept-new</string>
    <string>-o</string>
    <string>IdentitiesOnly=yes</string>
    <string>-i</string>
    <string>/Users/macstudio0/.ssh/&lt;TUNNEL_KEY&gt;</string>
    <string>-R</string>
    <string>127.0.0.1:18100:127.0.0.1:8100</string>
    <string>&lt;SSH_USER&gt;@bond.finailab.cn</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/macstudio0/bond-factor-lab-runtime/logs/com.bond-factor-lab.ssh-tunnel.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/macstudio0/bond-factor-lab-runtime/logs/com.bond-factor-lab.ssh-tunnel.err</string>
</dict>
</plist>
