{
  "profile_name": "blackbox-v2-v1",
  "conda_env": "forecast_env_blackbox_v1",
  "data_schema_version": "data-bridge-v1",
  "contract_version": "1.0",
  "cpu_threads": 8,
  "memory_limit_bytes": 68719476736,
  "predict_timeout_sec": 600,
  "backtest_timeout_sec": 14400,
  "max_batch_requests": 100,
  "max_output_bytes": 52428800,
  "max_log_bytes": 5242880,
  "max_run_dir_bytes": 67108864,
  "max_run_dir_entries": 10000,
  "sandbox_enabled": true,
  "read_roots": [
    {
      "path": "/opt/homebrew/opt/libomp/lib",
      "resolved_boundary": "/opt/homebrew/Cellar/libomp"
    }
  ],
  "environment_allowlist": [
    "LANG",
    "LC_ALL",
    "TZ"
  ],
  "environment_defaults": {
    "LANG": "C.UTF-8",
    "TZ": "Asia/Shanghai"
  },
  "network_access": false,
  "database_access": false
}
