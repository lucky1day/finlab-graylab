[Unit]
Description=Bond Factor Lab DataBridge refresh one-shot
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/bond-factor-lab/current
EnvironmentFile=/etc/bond-factor-lab/bond-factor-lab.env
EnvironmentFile=/opt/bond-factor-lab/current/.bfl-release.env
EnvironmentFile=-/run/bond-factor-lab/manual-run.env
Environment=PATH=/opt/miniconda3/condabin:/opt/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/root
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BFL_DEPLOYMENT_TARGET=aliyun-gray
Environment=BOND_FACTOR_LAB_CONTROL_PLANE=systemd_one_shot
Environment=BFL_DATABRIDGE_PRODUCER=systemd-one-shot
ExecStart=/opt/miniconda3/envs/bond_factor_lab_service/bin/python scripts/refresh_data_bridge_current.py --publish
TimeoutStartSec=1h
TimeoutStopSec=300
KillMode=control-group
UMask=0077
