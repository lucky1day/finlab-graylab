# shared.db_config 不会自动加载本文件；开发入口须显式导出这些值，
# 或将 BFL_DATABASE_ENV_FILE 指向权限为 0600 的绝对路径。
BOND_DB_HOST=127.0.0.1
BOND_DB_PORT=3306
BOND_DB_USER=replace_me
BOND_DB_PASSWORD=replace_me
BOND_DB_NAME=bond_db
BOND_DB_CHARSET=utf8mb4

BOND_ALGO_CONDA_ENV=forecast_env

DATABRIDGE_API_BASE_URL=http://101.132.253.22:5040/api/
DATABRIDGE_API_USERNAME=ddd
DATABRIDGE_API_PASSWORD=
DATABRIDGE_REFRESH_START=06:30
DATABRIDGE_REFRESH_DEADLINE=07:00
DATABRIDGE_DAILY_CHUNK_MONTHS=3
DATABRIDGE_DOWNLOAD_CONCURRENCY=4
